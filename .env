# ZhiFa-Eval 服务端配置
# 填写后重启服务即可生效，前端无需再手动输入

# 推理模型（被测模型）
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
INFERENCE_MODEL=

# 裁判模型（LLM-as-Judge）
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# ─── 6 个并行生成 Rubric 答案的 API Key ──────────────────
# 每个任务一个 key，支持并行调用，不填则用 INFERENCE_API_KEY 兜底
# 格式：BASE_URL|API_KEY|MODEL（用竖线分隔）
RUBRIC_API_1=
RUBRIC_API_2=
RUBRIC_API_3=
RUBRIC_API_4=
RUBRIC_API_5=
RUBRIC_API_6=

# ─── 智法AI 评测用 API Key（6 条并行） ────────────────────
# 跑 run_zhifa_eval.py 时通过 --key 1~6 选用
ZHIFA_KEY_1=
ZHIFA_KEY_2=
ZHIFA_KEY_3=
ZHIFA_KEY_4=
ZHIFA_KEY_5=
ZHIFA_KEY_6=


# 格式：BASE_URL|API_KEY|MODEL|DISPLAY_NAME
JUDGE_1=
JUDGE_2=
JUDGE_3=
